#!/bin/sh
# filepath: /home/joseph/project/nuc980/initramfs/output/target/etc/init.d/S90mount_data

sync_data_partition() {
    echo "Syncing data partition..."
    sync
    # Force filesystem sync for YAFFS2
    echo 3 > /proc/sys/vm/drop_caches 2>/dev/null || true
    sync
    echo "✅ Data partition synced"
}

clean_python() {
    echo "Cleaning Python cache..."
    find /data -name "__pycache__" -type d -exec rm -rf {} + 2>/dev/null
    find /data -name "*.pyc" -type f -delete 2>/dev/null
    echo "✅ Python cache cleaned"
}

start_services() {
    echo "Starting data mount and services..."
    
    # Mount data partition
    mkdir -p /data
    mount -t yaffs2 /dev/mtdblock5 /data

    
    if [ $? -eq 0 ]; then
        echo "✅ Data partition mounted successfully"
        
        # ✅ Source profile but preserve working directory
        ORIGINAL_PWD=$(pwd)
        . /etc/profile
        cd "$ORIGINAL_PWD"
        echo "✅ Environment loaded from profile"

        # Clean Python cache on startup
        clean_python
        
        # Test Python before starting services
        echo "Testing Python..."
        if /data/usr/bin/python3 -c "print('Python OK')" 2>/dev/null; then
            echo "✅ Python test passed"
        else
            echo "❌ Python test failed, cleaning and retrying..."
            clean_python
            
            if ! /data/usr/bin/python3 -c "print('Python OK')" 2>/dev/null; then
                echo "❌ Python still broken, skipping web server"
                return
            fi
        fi
        
        # Start telnetd
        echo "Starting telnetd..."
        /data/telnetd &
        echo "✅ telnetd started"
        
        # Wait a moment for system to settle
        sleep 2
        
        # Start Gateway Controller
        echo "Starting Gateway Controller..."
        cd /data/controller
        
        if [ -f "./start_gateway.sh" ]; then
            chmod +x ./start_gateway.sh
            # Rotate log if it gets too big (>500KB) - protect RAM
            if [ -f "/tmp/gateway.log" ] && [ $(stat -c%s "/tmp/gateway.log" 2>/dev/null || echo 0) -gt 512000 ]; then
                # Keep only last 100KB when rotating
                tail -c 102400 /tmp/gateway.log > /tmp/gateway.log.tmp 2>/dev/null
                mv /tmp/gateway.log.tmp /tmp/gateway.log 2>/dev/null
            fi
            ./start_gateway.sh >> /tmp/gateway.log 2>&1 &
            GATEWAY_PID=$!
            echo "✅ Gateway Controller started (PID: $GATEWAY_PID)"
            echo $GATEWAY_PID > /tmp/gateway.pid
        else
            echo "❌ start_gateway.sh not found"
        fi
        
    else
        echo "❌ Failed to mount data partition"
    fi
}

# If no parameter provided (boot execution), start services
if [ -z "$1" ]; then
    start_services
    exit 0
fi

# Handle manual parameters
case "$1" in
    start)
        start_services
        ;;
        
    stop)
        echo "Stopping services and unmounting data..."
        
        # Stop Gateway Controller
        if [ -f /tmp/gateway.pid ]; then
            GATEWAY_PID=$(cat /tmp/gateway.pid)
            if [ -n "$GATEWAY_PID" ]; then
                kill $GATEWAY_PID 2>/dev/null
                echo "✅ Gateway Controller stopped"
                rm -f /tmp/gateway.pid
            fi
        fi
        
        # Stop telnetd
        killall telnetd 2>/dev/null
        echo "✅ telnetd stopped"
        
        # ✅ CRITICAL: Sync before unmount
        sync_data_partition
        
        # Unmount data partition
        umount /data
        if [ $? -eq 0 ]; then
            echo "✅ Data partition unmounted safely"
        else
            echo "❌ Failed to unmount data partition"
        fi
        ;;
        
    sync)  # ✅ NEW: Manual sync command
        sync_data_partition
        ;;
        
    shutdown)  # ✅ NEW: Proper shutdown sequence
        echo "Preparing for shutdown..."
        
        # Stop all services
        $0 stop
        
        # Final system sync
        echo "Final system sync..."
        sync
        sync
        sync
        echo "✅ System ready for power-off"
        ;;
        
    restart)
        $0 stop
        sleep 2
        $0 start
        ;;
        
    clean)
        echo "Cleaning system..."
        clean_python
        rm -rf /data/tmp/* 2>/dev/null
        # Clean RAM logs
        rm -f /tmp/gateway.log /tmp/gateway.pid 2>/dev/null
        sync_data_partition  # ✅ Sync after cleanup
        echo "✅ Cleanup complete"
        ;;
        
    python_test)
        echo "Testing Python installation..."
        /data/usr/bin/python3 -c "
import sys
print('✅ Python version:', sys.version)
print('✅ Python executable:', sys.executable)
print('✅ Python path:', sys.path)
try:
    import dbus
    print('✅ D-Bus import successful')
except ImportError as e:
    print('❌ D-Bus import failed:', e)
"
        ;;
        
    logs)
        echo "=== Gateway Logs ==="
        if [ -f /tmp/gateway.log ]; then
            LOG_SIZE=$(stat -c%s "/tmp/gateway.log" 2>/dev/null || echo 0)
            echo "📊 Log size: $((LOG_SIZE/1024))KB"
            echo "📄 Last 20 lines:"
            tail -20 /tmp/gateway.log
        else
            echo "❌ No log file found"
        fi
        ;;
        
    upload_logs)  # TODO: Future log upload to server
        echo "🚀 Log upload feature - coming soon!"
        if [ -f /tmp/gateway.log ]; then
            LOG_SIZE=$(stat -c%s "/tmp/gateway.log" 2>/dev/null || echo 0)
            echo "📊 Ready to upload: $((LOG_SIZE/1024))KB"
            # Future: curl/wget to upload logs to server
        fi
        ;;
        
    status)
        echo "=== Service Status ==="
        
        # Check data mount
        if mount | grep -q "/data"; then
            echo "✅ Data partition: mounted"
        else
            echo "❌ Data partition: not mounted"
        fi
        
        # Check NAND health
        echo ""
        echo "=== NAND Flash Status ==="
        cat /proc/mtd
        
        # Test Python
        if /data/usr/bin/python3 -c "print('OK')" 2>/dev/null; then
            echo "✅ Python: working"
        else
            echo "❌ Python: broken"
        fi
        
        # Check services...
        if pgrep telnetd > /dev/null; then
            echo "✅ telnetd: running"
        else
            echo "❌ telnetd: not running"
        fi
        
        if [ -f /tmp/gateway.pid ]; then
            GATEWAY_PID=$(cat /tmp/gateway.pid)
            if kill -0 $GATEWAY_PID 2>/dev/null; then
                echo "✅ Gateway Controller: running (PID: $GATEWAY_PID)"
                # Show log size
                LOG_SIZE=$(stat -c%s "/tmp/gateway.log" 2>/dev/null || echo 0)
                echo "📊 Log size: $((LOG_SIZE/1024))KB"
            else
                echo "❌ Gateway Controller: not running (stale PID file)"
                rm -f /tmp/gateway.pid
            fi
        else
            echo "❌ Gateway Controller: not running"
        fi
        ;;
        
    *)
        echo "Usage: $0 {start|stop|restart|status|clean|sync|shutdown|python_test|logs|upload_logs}"
        exit 1
        ;;
esac

exit 0